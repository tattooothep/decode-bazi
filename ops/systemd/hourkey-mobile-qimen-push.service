[Unit]
Description=Hourkey Qimen C4 three-layer notification scheduler
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/releases/current
Environment=NODE_ENV=production
EnvironmentFile=-/etc/hourkey/hourkey.env
StateDirectory=hourkey-notification
UMask=0027
ExecStart=/usr/bin/node --import tsx /root/releases/current/scripts/mobile-qimen-push-cron.cjs --batch=500 --workers=20
TimeoutStartSec=50
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/hourkey-notification
StandardOutput=append:/var/log/hourkey/mobile-qimen-push.log
StandardError=append:/var/log/hourkey/mobile-qimen-push.log
